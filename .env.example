# Copy this file to `.env` and adjust. Never commit `.env`.

# Port the app listens on inside the container.
PORT=3000

# Directory holding the SQLite database and uploaded files.
# Leave unset: local runs default to ./data, the container sets /data to match
# its volume mount. Only override if you know what you are doing.
# DATA_DIR=./data

# The admin password is managed from the UI, not the environment. A fresh
# install starts with the bootstrap password "changeme" and the first visit to
# /admin forces you to pick your own. Forgot it? Reset from the container:
#   docker exec -it profile-page node src/reset-password.ts

# Session cookie signing secret. If unset, a random one is generated on first
# run and persisted in the database. Set a long random value to pin it.
# SESSION_SECRET=

# Session cookies get the Secure flag when "true". Defaults to true when
# NODE_ENV=production (the container), false otherwise. Set to "false" only for
# plain-HTTP local development.
SECURE_COOKIES=true

# Public base URL, used for absolute URLs in meta tags (og:url, og:image).
# Falls back to the request host when unset.
# BASE_URL=https://example.com
